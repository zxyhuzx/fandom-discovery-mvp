# Build-time PUBLIC values only. Both have safe checked-in defaults for this project.
PUBLIC_SUPABASE_URL=https://plxdnppizgvrqakjyehm.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY

# Local migration / integration tests only. Do not add this to the browser or Vercel.
# macOS can reuse the existing Supabase CLI keychain instead.
# SUPABASE_ACCESS_TOKEN=

# Kakao REST API key and Client Secret are entered only in Supabase > Auth > Kakao.
# No real Kakao message credentials or sending switch are implemented.

# X API: SERVER ONLY, set in Supabase Edge Function secrets, never PUBLIC_*.
# X_BEARER_TOKEN=
# X_API_ENABLED=false
# X_MONTHLY_RESOURCE_LIMIT=2000
# X_DAILY_RESOURCE_LIMIT=20
# Configure the console's dollar spending cap too; no automatic recharge.
